<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check 误报抑制文件（Issue #80 / UC11 Critical 整改 #4）

  此文件初始为空。当 dependencyCheckAnalyze 报出 false positive 时，
  在此添加 <suppress> 节点。每条 suppression 必须包含：
    - <notes>: 说明为何 suppress
    - <packageUrl regex="true">: 受影响的包 PURL（pkg:maven/group/artifact）
    - <cve>: 具体 CVE 编号（OR <cvssBelow>: 阈值）

  生成模板：跑 dependencyCheckAnalyze 后，HTML 报告会给 suppression 建议片段。
  文档：https://jeremylong.github.io/DependencyCheck/general/suppression.html
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
  示例（注释，不生效）：
  <suppress>
    <notes>example - jbcrypt 0.4 历史 CVE 不适用本项目（不暴露 hashpw API 给外部）</notes>
    <packageUrl regex="true">^pkg:maven/org\.mindrot/jbcrypt@.*$</packageUrl>
    <cve>CVE-XXXX-XXXX</cve>
  </suppress>
  -->
</suppressions>

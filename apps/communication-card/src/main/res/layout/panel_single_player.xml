<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="单人游戏设置"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:background="@color/accent" />

    <!-- 难度选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/difficulty"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <RadioGroup
        android:id="@+id/rgDifficulty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbEasy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:buttonTint="@color/accent"
            android:text="@string/difficulty_easy"
            android:textColor="@color/text_secondary" />

        <RadioButton
            android:id="@+id/rbMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:buttonTint="@color/accent"
            android:checked="true"
            android:text="@string/difficulty_medium"
            android:textColor="@color/text_secondary" />

        <RadioButton
            android:id="@+id/rbHard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:text="@string/difficulty_hard"
            android:textColor="@color/text_secondary" />

    </RadioGroup>

    <!-- 人数选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/player_count"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <RadioGroup
        android:id="@+id/rgPlayerCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb6Players"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:buttonTint="@color/accent"
            android:checked="true"
            android:text="@string/players_6"
            android:textColor="@color/text_secondary" />

        <RadioButton
            android:id="@+id/rb8Players"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:text="@string/players_8"
            android:textColor="@color/text_secondary" />

    </RadioGroup>

    <!-- 开始按钮 -->
    <Button
        android:id="@+id/btnStartGame"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/button_primary"
        android:text="开始游戏"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>

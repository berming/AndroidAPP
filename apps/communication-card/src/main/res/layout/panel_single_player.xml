<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="单人游戏"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:layout_marginTop="6dp"
        android:background="@color/accent" />

    <!-- 横向布局：左设置，右开始按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧设置区 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 难度选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/difficulty"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rgDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbEasy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/difficulty_easy"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:buttonTint="@color/accent"
                    android:checked="true"
                    android:text="@string/difficulty_medium"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbHard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent"
                    android:text="@string/difficulty_hard"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </RadioGroup>

            <!-- 人数选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/player_count"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rgPlayerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb6Players"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:buttonTint="@color/accent"
                    android:checked="true"
                    android:text="@string/players_6"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb8Players"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent"
                    android:text="@string/players_8"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </RadioGroup>

        </LinearLayout>

        <!-- 右侧开始按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnStartGame"
                android:layout_width="160dp"
                android:layout_height="60dp"
                android:background="@drawable/button_primary"
                android:text="开始游戏"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

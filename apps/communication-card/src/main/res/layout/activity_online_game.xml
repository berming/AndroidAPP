<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_game"
    tools:context=".ui.multiplayer.OnlineGameActivity">

    <!-- 玩家排列 -->
    <LinearLayout
        android:id="@+id/playersRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/currentRoundArea"
        app:layout_constraintHeight_percent="0.22">

        <include
            android:id="@+id/player1"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

        <include
            android:id="@+id/player2"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

        <include
            android:id="@+id/player3"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

        <include
            android:id="@+id/player4"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

        <include
            android:id="@+id/player5"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

        <include
            android:id="@+id/player6"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 当前轮显示区域 -->
    <FrameLayout
        android:id="@+id/currentRoundArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="4dp"
        android:background="@drawable/current_round_background"
        app:layout_constraintTop_toBottomOf="@id/playersRow"
        app:layout_constraintBottom_toTopOf="@id/playerHandArea"
        app:layout_constraintHeight_percent="0.12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- 红队得分 -->
            <TextView
                android:id="@+id/tvTeamAScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/team_a"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="红队:0分" />

            <!-- 蓝队得分 -->
            <TextView
                android:id="@+id/tvTeamBScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/team_b"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="蓝队:0分" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="8dp"
                android:background="#40FFFFFF" />

            <!-- 本轮得分 -->
            <TextView
                android:id="@+id/tvRoundScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/score_positive"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="本轮:15分" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="8dp"
                android:background="#40FFFFFF" />

            <!-- 当前领先玩家 -->
            <TextView
                android:id="@+id/tvCurrentLeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="14sp"
                tools:text="玩家2:" />

            <!-- 当前最大牌 -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/currentWinningCards"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />

            </HorizontalScrollView>

            <!-- 回合倒计时 -->
            <TextView
                android:id="@+id/tvTurnTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/timer_normal"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="30秒" />

        </LinearLayout>

        <!-- 消息提示 -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="玩家3 赢得此轮" />

    </FrameLayout>

    <!-- 玩家手牌区域 -->
    <LinearLayout
        android:id="@+id/playerHandArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#40000000"
        android:orientation="vertical"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.48">

        <!-- 玩家信息和操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="4dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/team_a" />

                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/you"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerCardCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="36张" />

                <TextView
                    android:id="@+id/tvPlayerScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/score_positive"
                    android:textSize="14sp"
                    tools:text="已收:0分" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvGameStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="轮到你出牌" />

            <Button
                android:id="@+id/btnHint"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_secondary"
                android:text="提示"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPass"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_secondary"
                android:text="过牌"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_primary"
                android:text="出牌"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 手牌两行显示 -->
        <LinearLayout
            android:id="@+id/handCardsArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/playerHandRow1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />

            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/playerHandRow2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />

            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

    <!-- 聊天FAB - 可拖动，半透明，缩小尺寸 -->
    <FrameLayout
        android:id="@+id/fabChat"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="8dp"
        android:alpha="0.55"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/fab_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_dialog_email"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvUnreadCount"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:background="@drawable/badge_background"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:visibility="gone"
            tools:text="5"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- 聊天面板 -->
    <include
        android:id="@+id/chatPanel"
        layout="@layout/view_chat_panel"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 游戏结束遮罩 -->
    <FrameLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/center_area_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvGameOverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="胜利!" />

            <TextView
                android:id="@+id/tvGameOverResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                tools:text="恭喜你的队伍获胜！" />

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/score_positive"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="红队 215 : 125 蓝队" />

            <Button
                android:id="@+id/btnBackMenu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_primary"
                android:text="返回大厅"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 重连遮罩 -->
    <FrameLayout
        android:id="@+id/reconnectOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="正在重新连接..."
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

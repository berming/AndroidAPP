<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_game"
    tools:context=".ui.GameActivity">

    <!-- 玩家2-6横向排列 (红蓝交替: 2蓝,3红,4蓝,5红,6蓝) -->
    <LinearLayout
        android:id="@+id/playersRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/currentRoundArea"
        app:layout_constraintHeight_percent="0.22">

        <include
            android:id="@+id/player2"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

        <include
            android:id="@+id/player3"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

        <include
            android:id="@+id/player4"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

        <include
            android:id="@+id/player5"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

        <include
            android:id="@+id/player6"
            layout="@layout/view_player_with_cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp" />

    </LinearLayout>

    <!-- 当前轮最大牌显示区域 + 队伍得分 -->
    <FrameLayout
        android:id="@+id/currentRoundArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="4dp"
        android:background="@drawable/current_round_background"
        app:layout_constraintTop_toBottomOf="@id/playersRow"
        app:layout_constraintBottom_toTopOf="@id/playerHandArea"
        app:layout_constraintHeight_percent="0.12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- 红队得分 -->
            <TextView
                android:id="@+id/tvTeamAScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/team_a"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="红队:0分" />

            <!-- 蓝队得分 - 紧跟红队 -->
            <TextView
                android:id="@+id/tvTeamBScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/team_b"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="蓝队:0分" />

            <!-- 分隔 -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="8dp"
                android:background="#40FFFFFF" />

            <!-- 本轮总分 -->
            <TextView
                android:id="@+id/tvRoundScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/score_positive"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="本轮:15分" />

            <!-- 分隔 -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="8dp"
                android:background="#40FFFFFF" />

            <!-- 当前领先玩家 -->
            <TextView
                android:id="@+id/tvCurrentLeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="14sp"
                tools:text="玩家2:" />

            <!-- 当前最大牌 -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/currentWinningCards"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />

            </HorizontalScrollView>

        </LinearLayout>

        <!-- 消息提示 -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="玩家3 赢得此轮，获得 25 分" />

    </FrameLayout>

    <!-- 玩家手牌区域 -->
    <LinearLayout
        android:id="@+id/playerHandArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#40000000"
        android:orientation="vertical"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.48">

        <!-- 玩家信息、游戏状态和操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- 玩家信息 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="4dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/team_a" />

                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/you"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerCardCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="36张" />

                <TextView
                    android:id="@+id/tvPlayerScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/score_positive"
                    android:textSize="14sp"
                    tools:text="已收:0分" />

            </LinearLayout>

            <!-- 游戏状态提示 - 居中显示 -->
            <TextView
                android:id="@+id/tvGameStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="轮到你出牌" />

            <!-- 记录按钮 -->
            <Button
                android:id="@+id/btnHistory"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_secondary"
                android:text="记录"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <!-- 托管按钮 (AI代打) -->
            <Button
                android:id="@+id/btnAutoPlay"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_secondary"
                android:text="托管"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <!-- 操作按钮 -->
            <Button
                android:id="@+id/btnHint"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_secondary"
                android:text="提示"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPass"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_secondary"
                android:text="过牌"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_primary"
                android:text="出牌"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <!-- AI 接管 / 取消（feature_spec G34）-->
            <Button
                android:id="@+id/btnAiTakeover"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_secondary"
                android:text="@string/btn_ai_takeover_on"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <!-- 暂离 / 回归（feature_spec G35，仅多人）-->
            <Button
                android:id="@+id/btnAfk"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:background="@drawable/button_secondary"
                android:text="@string/btn_afk"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- 手牌 - 两行显示 (点击空白处取消选牌) -->
        <LinearLayout
            android:id="@+id/handCardsArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <!-- 第一行手牌 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/playerHandRow1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />

            </HorizontalScrollView>

            <!-- 两行之间的边距 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- 第二行手牌 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/playerHandRow2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />

            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

    <!-- 游戏记录弹窗 (两栏分页) -->
    <FrameLayout
        android:id="@+id/historyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:background="@drawable/center_area_background"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="游戏记录"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHistoryPageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:text="1/1" />

            </LinearLayout>

            <!-- 两栏内容区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHistoryColumn1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#30FFFFFF" />

                <TextView
                    android:id="@+id/tvHistoryColumn2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- 分页控制栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnHistoryPrev"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:background="@drawable/button_secondary"
                    android:text="上一页"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCloseHistory"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/button_primary"
                    android:text="关闭"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnHistoryNext"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:background="@drawable/button_secondary"
                    android:text="下一页"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- 游戏回放遮罩 -->
    <FrameLayout
        android:id="@+id/replayOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp"
            android:background="@drawable/center_area_background"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="游戏回放"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReplayProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="1/50" />

            </LinearLayout>

            <!-- 当前步骤牌面显示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReplayStepInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="玩家2 出牌:" />

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/replayCardsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp" />

                </HorizontalScrollView>

            </LinearLayout>

            <!-- 回放内容显示区 -->
            <ScrollView
                android:id="@+id/replayScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvReplayContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="6dp" />

            </ScrollView>

            <!-- 回放控制按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnReplayFirst"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_secondary"
                    android:text="首步"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnReplayPrev"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_secondary"
                    android:text="上步"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnReplayAutoPlay"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_primary"
                    android:text="自动播放"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnReplayNext"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_secondary"
                    android:text="下步"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnReplayLast"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:background="@drawable/button_secondary"
                    android:text="末步"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnCloseReplay"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_primary"
                android:text="关闭"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 游戏结束遮罩 -->
    <FrameLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/center_area_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvGameOverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="游戏结束" />

            <TextView
                android:id="@+id/tvGameOverResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                tools:text="你的队伍获胜！" />

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                tools:text="红队 220 分 vs 蓝队 180 分" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlayAgain"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/button_primary"
                    android:text="@string/btn_play_again"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnShowHistory"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/button_secondary"
                    android:text="记录"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnShowReplay"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/button_secondary"
                    android:text="回放"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnBackMenu"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:background="@drawable/button_secondary"
                    android:text="@string/btn_back_menu"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_game"
    android:padding="16dp"
    tools:context=".ui.multiplayer.RoomActivity">

    <!-- 顶部信息栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnLeave"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/button_secondary"
            android:text="离开"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRoomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="200dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="我的房间" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="房间码: "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRoomCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="ABC123" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPlayerCount"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            tools:text="2/6 玩家" />

    </LinearLayout>

    <!-- 玩家列表区域 -->
    <LinearLayout
        android:id="@+id/playersContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- 红队 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/team_a_background"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="红队"
                android:textColor="@color/team_a"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/teamAPlayers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="vertical" />

        </LinearLayout>

        <View
            android:layout_width="16dp"
            android:layout_height="match_parent" />

        <!-- 蓝队 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/team_b_background"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="蓝队"
                android:textColor="@color/team_b"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/teamBPlayers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 准备按钮（非房主显示） -->
        <Button
            android:id="@+id/btnReady"
            android:layout_width="160dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_secondary"
            android:text="准备"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 开始按钮（房主显示） -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:background="@drawable/button_primary"
            android:enabled="false"
            android:text="开始游戏"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 添加AI按钮（房主显示） -->
        <Button
            android:id="@+id/btnAddAI"
            android:layout_width="120dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_secondary"
            android:text="添加AI"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- 房间 AI 速度（仅房主显示，feature_spec G37） -->
        <Button
            android:id="@+id/btnRoomAiSpeed"
            android:layout_width="120dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_secondary"
            android:text="@string/settings_room_ai_speed"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 我的托管速度（每个玩家可见，feature_spec G38） -->
        <Button
            android:id="@+id/btnMyTakeoverSpeed"
            android:layout_width="120dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_secondary"
            android:text="@string/settings_my_takeover_speed"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 聊天按钮 - 可拖动，半透明 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:alpha="0.6"
        android:src="@android:drawable/ic_dialog_email"
        app:backgroundTint="@color/accent"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/text_primary" />

    <!-- 聊天未读数 -->
    <TextView
        android:id="@+id/tvUnreadCount"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/badge_background"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/fabChat"
        app:layout_constraintTop_toTopOf="@id/fabChat"
        tools:text="3"
        tools:visibility="visible" />

    <!-- 聊天面板 -->
    <include
        android:id="@+id/chatPanel"
        layout="@layout/view_chat_panel"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

</androidx.constraintlayout.widget.ConstraintLayout>

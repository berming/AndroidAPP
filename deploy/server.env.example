# 沟通牌服务端环境变量（生产 systemd 读取的 EnvironmentFile）
#
# 部署位置：/etc/communication-card/server.env（root:cards owned, chmod 600）
# install.sh 第一次部署时会引导生成并写入；此文件是占位 / 示例。
#
# ⚠️ ADMIN_INITIAL_PASSWORD 是**首次启动**用的明文初始密码。服务端检测到
# admin_users 表为空才会用它创建 SUPER_ADMIN 账号；之后**必须**手动删掉
# 这一行（或改成占位符），避免日后误重置。

# Admin 后台 SQLite 路径（如不写则用 application.conf 默认值）
# ADMIN_DB_PATH=/var/lib/communication-card/admin.db

# session cookie 是否要求 Secure（HTTPS-only）。生产 = true；本地开发可暂置 false
ADMIN_COOKIE_SECURE=true

# Cookie 域：未来玩家账号系统接入时若需 cookie 跨子域，留空让浏览器用请求域
ADMIN_COOKIE_DOMAIN=bermin.cn

# === 首次启动初始 admin ===
# 表为空时用这两个值创建 SUPER_ADMIN；表非空时**完全忽略**。
# 第一次成功登录后请删掉 ADMIN_INITIAL_PASSWORD 行（或改为空）。
ADMIN_INITIAL_USERNAME=root
ADMIN_INITIAL_PASSWORD=__REPLACE_WITH_STRONG_PASSWORD_AT_LEAST_8_CHARS__

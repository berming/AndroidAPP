# 沟通牌 · Caddy 配置
#
# 当前模式：bermin.cn 域名 + Let's Encrypt 自动 HTTPS（方案 B）+ IP fallback
# DNS 前提：A 记录 bermin.cn → 服务器公网 IP，且腾讯云安全组已放行 80/443

# ============================================================
# 主站：bermin.cn — 自动 HTTPS（Caddy 自动申请 + 续期 Let's Encrypt 证书）
# ============================================================
bermin.cn {
    # 用 handle 块互斥：ws 走 reverse_proxy，其他走静态文件。
    # 不能用 `try_files {path} /index.html` —— 它会重写请求 path，
    # 导致 @ws matcher 的 `path /game` 失配，ws 握手挂掉。
    @ws {
        path /game
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @ws {
        reverse_proxy 127.0.0.1:8080
    }

    # Admin REST API：/admin/api/* 和 /admin-auth/* → Ktor。
    # 必须在 handle_path /admin/* 之前，否则 SPA 静态文件兜底会吞掉 API 请求。
    @adminApi {
        path /admin/api/* /admin-auth/*
    }
    handle @adminApi {
        reverse_proxy 127.0.0.1:8080
    }

    # /admin（无尾斜杠）→ /admin/，确保 handle_path /admin/* 能命中
    @adminBare path /admin
    redir @adminBare /admin/ 301

    # Admin SPA：剥前缀 /admin 后从 /var/www/communication-card-admin/ 提供。
    # try_files {path} /index.html → Vue Router history mode 兜底
    handle_path /admin/* {
        root * /var/www/communication-card-admin
        encode gzip zstd
        try_files {path} /index.html
        file_server
    }

    # Huigu-AI 股票报告（独立项目，berming/Huigu-AI 仓库经 GitHub Actions rsync
    # 到 /var/www/huigu-stocks）。与游戏路由互不重叠：/ 游戏、/admin/ 后台、
    # /stocks/ 股票报告。Caddy 按 path specificity 自动排序，/stocks/* 比根
    # handle{} 更具体，不会被兜底吞掉。
    # /stocks（无尾斜杠）→ /stocks/，确保 handle_path 能命中首页
    @stocksBare path /stocks
    redir @stocksBare /stocks/ 301
    handle_path /stocks/* {
        root * /var/www/huigu-stocks
        encode gzip zstd
        file_server
    }

    handle {
        root * /var/www/communication-card-web
        encode gzip zstd

        # 显式给 .wasm 设 MIME，避免有些静态服务推断错
        @wasm path *.wasm
        header @wasm Content-Type application/wasm

        file_server
    }

    log {
        output file /var/log/caddy/communication-card.log
        format console
    }
}

# ============================================================
# IP 访问 fallback（保留以兼容旧客户端 / DNS 未生效）：
#   · 旧 Android (≤ a5d050e) 硬编码 ws://<ip>/game，仍能走这条
#   · 浏览器访问 http://<ip>/ 自动 301 到 https://bermin.cn
# ============================================================
:80 {
    @ws {
        path /game
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @ws {
        reverse_proxy 127.0.0.1:8080
    }

    handle {
        # 浏览器/HTTP 静态请求 → 引导到正式域名 HTTPS
        redir https://bermin.cn{uri} permanent
    }
}

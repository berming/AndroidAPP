<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CommunicationCard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <!-- 按钮样式 -->
    <style name="GameButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="GameButton.Play">
        <item name="backgroundTint">@color/button_play</item>
    </style>

    <style name="GameButton.Pass">
        <item name="backgroundTint">@color/button_pass</item>
    </style>

    <style name="GameButton.Large" parent="GameButton">
        <item name="android:textSize">24sp</item>
        <item name="android:paddingHorizontal">48dp</item>
        <item name="android:paddingVertical">16dp</item>
    </style>

    <!-- 卡片样式 -->
    <style name="CardStyle">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">4dp</item>
    </style>
</resources>
